{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bottles",
  "version": "0.1.5",
  "identifier": "com.susul.bottles",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bottles - 漂流瓶",
        "width": 800,
        "height": 700,
        "minWidth": 500,
        "minHeight": 500,
        "useHttpsScheme": true,
        "url": "index.html",
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
